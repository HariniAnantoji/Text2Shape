# Text2Shape backend configuration.
# Copy to .env for local development:  Copy-Item .env.example .env
# NEVER commit a real .env or real secrets. Commit only this example.

# ---------------------------------------------------------------------------
# CORS: comma-separated list of exact allowed frontend origins (no "*").
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# LLM configuration
#
# Two modes:
#
# A) LOCAL OLLAMA (default, no API key). Leave LLM_BASE_URL unset.
# ---------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# B) HOSTED LLAMA (for AWS / "not just locally"). Set LLM_BASE_URL to an
#    OpenAI-compatible chat-completions base URL, pick a model, and provide
#    the API key via ONE of the two options below.
#    Examples of OpenAI-compatible providers that host Llama:
#      Together AI : https://api.together.xyz/v1
#      Groq        : https://api.groq.com/openai/v1
#      Fireworks   : https://api.fireworks.ai/inference/v1
# ---------------------------------------------------------------------------
# LLM_BASE_URL=https://api.together.xyz/v1
# LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct-Turbo

# Option 1: provide the key directly (fine for local dev only).
# LLM_API_KEY=sk-your-local-dev-key

# Option 2 (recommended for AWS): fetch the key from AWS Secrets Manager at
# runtime. Set the secret's ARN (or name) here and give the task/role
# secretsmanager:GetSecretValue on it. The secret may be a raw string or a
# JSON object like {"LLM_API_KEY":"sk-..."}.
# LLM_API_KEY_SECRET_ARN=arn:aws:secretsmanager:us-east-2:111122223333:secret:text2shape/llm-api-key

# ---------------------------------------------------------------------------
# S3 artifact storage (optional). When S3_BUCKET_NAME is unset, files are
# stored on the container's local disk (not durable across ECS task restarts).
# ---------------------------------------------------------------------------
# S3_BUCKET_NAME=text2shape-cad-artifacts-2026
# AWS_REGION=us-east-2
